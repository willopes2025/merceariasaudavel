# Copie para .env e preencha. Nunca suba o .env para o GitHub.
#
#   cp .env.production.example .env
#   sed -i "s/^POSTGRES_PASSWORD=.*/POSTGRES_PASSWORD=$(openssl rand -hex 24)/" .env
#   sed -i "s/^JWT_SECRET=.*/JWT_SECRET=$(openssl rand -hex 32)/" .env

POSTGRES_USER=mercearia
POSTGRES_PASSWORD=
POSTGRES_DB=mercearia

# Assina o login. Mínimo de 32 caracteres; trocar desloga todo mundo.
JWT_SECRET=
JWT_ACCESS_TTL=12h

# Isolamento por organização no banco (deixe on).
DB_ISOLATION=on

# Nome da rede Docker do Soul ERP (onde está o Caddy). Confira: docker network ls
SOUL_NETWORK=erp_default

# API Consultiva do ssÓtica, para a carga de clientes (Configurações › Importar do ssÓtica).
# Token: no ssÓtica, Cadastro › Usuários › abrir o usuário › código de acesso.
# Identifique a loja pelo CNPJ OU pelo código da licença (ex.: VW9J-YPYI).
SSOTICA_TOKEN=
SSOTICA_CNPJ=
SSOTICA_EMPRESA=

# WhatsApp: DEIXE VAZIO. O Mercearia ainda não tem WhatsApp próprio (Fase 6);
# com isto vazio nada é enviado e a tela não oferece envio.
# Só preencha com uma URL https de verdade (ver DEPLOY.md, seção 10).
WHATSAPP_WEBHOOK_URL=

# Asaas (crediário com boleto). Vazio = crediário sem boleto, recebido na loja.
# A chave começa com "$": mantenha as ASPAS SIMPLES, senão ela chega cortada.
# ASAAS_ENV: sandbox (testes, padrão) ou production (dinheiro de verdade).
# ASAAS_WEBHOOK_TOKEN: gere com `openssl rand -hex 24` e cadastre o mesmo valor no webhook do Asaas.
ASAAS_API_KEY=''
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=
