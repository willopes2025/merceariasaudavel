# Copie para .env e preencha. Nunca suba o .env para o GitHub.
#
#   cp .env.production.example .env
#   sed -i "s/^POSTGRES_PASSWORD=.*/POSTGRES_PASSWORD=$(openssl rand -hex 24)/" .env
#   sed -i "s/^JWT_SECRET=.*/JWT_SECRET=$(openssl rand -hex 32)/" .env

POSTGRES_USER=mercearia
POSTGRES_PASSWORD=
POSTGRES_DB=mercearia

# Assina o login. Mínimo de 32 caracteres; trocar desloga todo mundo.
JWT_SECRET=
JWT_ACCESS_TTL=12h

# Isolamento por organização no banco (deixe on).
DB_ISOLATION=on

# Nome da rede Docker do Soul ERP (onde está o Caddy). Confira: docker network ls
SOUL_NETWORK=erp_default

# WhatsApp (atendimento, agente de IA e envios do assistente). Escolha UM jeito:
#  a) Z-API (número por QR Code): preencha as 3 chaves da instância.
#  b) API oficial (Meta Cloud API): token, id do número, segredo do app e um token de verificação que você inventa.
# WHATSAPP_INBOUND_SECRET: senha longa qualquer (openssl rand -hex 16); entra na URL de entrada que a tela mostra.
WHATSAPP_PROVIDER=
WHATSAPP_INBOUND_SECRET=
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
META_WA_TOKEN=
META_WA_PHONE_ID=
META_WA_APP_SECRET=
META_WA_VERIFY_TOKEN=
# Alternativa genérica (Make, n8n): recebe POST {"phone","message"}.
WHATSAPP_WEBHOOK_URL=

# Pagamento online pelo Mercado Pago (Pix e cartão no app, Pix no totem).
# Access Token de produção (APP_USR-...) e a assinatura secreta dos Webhooks.
# Vazio = pagamento online desligado. PAY_PROVIDER=teste liga um provedor de mentira (nada é cobrado).
PUBLIC_URL=https://mercearia.wideic.com
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Assistente (Claude). Cole a chave da Anthropic (sk-ant-...). Vazio = assistente desligado.
ANTHROPIC_API_KEY=
# Opcional: modelo do assistente (padrão no código).
IA_MODELO=
# Voz (opcional): OpenAI transcreve o microfone e fala; ElevenLabs fala com voz mais natural.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# E-mail das rotinas do assistente (opcional). Vazio = envio só simulado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Para onde vão os pedidos de melhoria que o assistente registra (opcional).
EMAIL_SUPORTE=
# Segundos entre mensagens no envio de WhatsApp em lote.
ASSISTENTE_INTERVALO_LOTE_S=20

# iFood: chaves do aplicativo criado no Portal do Desenvolvedor do iFood (tipo centralizado) e o id da loja no iFood.
# Sem as três, a integração fica desligada. IFOOD_STORE_ID só é preciso com mais de uma loja no sistema.
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_MERCHANT_ID=
IFOOD_STORE_ID=
# Disparos de WhatsApp: intervalo entre mensagens, em milissegundos.
BROADCAST_INTERVAL_MS=4000
# Arquivo AFD do ponto: número de registro do programa no INPI e CNPJ de quem desenvolveu (quando houver).
AFD_INPI=
AFD_DEV_DOC=
